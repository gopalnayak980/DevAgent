# Environment Variables for DevAgent Backend
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

# LLM Configuration
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45

# CORS — comma-separated list of allowed origins (no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Message validation
MAX_MESSAGE_LENGTH=4000

# Database (use SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./devagent.db

# Celery / Redis (Phase 7 — Background Agent Workflows)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Phase 10.1 — Security Settings
# ---------------------------------------------------------------------------

# Rate limiting (in-memory, development only — not suitable for multi-process deployments)
# RATE_LIMIT_REQUESTS: maximum number of POST requests per IP per window
# RATE_LIMIT_WINDOW_SECONDS: length of the sliding window in seconds
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum allowed request body size in bytes (default: 1 MB = 1048576)
MAX_REQUEST_BODY_BYTES=1048576

# Content-Security-Policy header value.
# The default below is permissive for local Vite development (HMR uses eval/inline scripts).
# For production, set a strict CSP here.
# CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self';

# ---------------------------------------------------------------------------
# Phase 10.2 — Authentication Settings
# ---------------------------------------------------------------------------

# JWT Secret Key - MUST BE CHANGED IN PRODUCTION
# You can generate one with: openssl rand -hex 32
JWT_SECRET_KEY="CHANGE_ME_IN_PRODUCTION_OR_ELSE"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
